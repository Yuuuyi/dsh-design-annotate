{
  "name": "@local/dsh-client-plugin-annotate",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Design annotation for HTML prototypes: open a prototype in a panel, pick an element, leave a note, and see it again whenever the flow reaches that state.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge.js",
    "export-viewer.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "vendor/html2canvas.min.js"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
